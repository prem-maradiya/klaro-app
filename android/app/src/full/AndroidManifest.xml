<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- POWER (direct-APK) distribution ONLY: SMS auto-capture. The manifest
         merger unions these into the main manifest for the `full` flavor; the
         `play` flavor never sees them, so the Play build declares no SMS
         permissions. Pair with the full flavor and KLARO_SMS=true. -->

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Keep the app alive to catch SMS in the background (Vivo battery killing) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- Background SMS receiver for the telephony package -->
        <receiver
            android:name="com.shounakmulay.telephony.sms.IncomingSmsReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
